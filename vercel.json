{
    "rewrites": [
        {
            "source": "/sitemap.xml",
            "destination": "/sitemap.xml"
        },
        {
            "source": "/robots.txt",
            "destination": "/robots.txt"
        },
        {
            "source": "/",
            "destination": "/api/index"
        },
        {
            "source": "/api",
            "destination": "/api/index"
        },
        {
            "source": "/api/auth/login",
            "destination": "/api/auth"
        },
        {
            "source": "/api/auth/register",
            "destination": "/api/auth"
        },
        {
            "source": "/api/auth/check-email",
            "destination": "/api/auth"
        },
        {
            "source": "/api/auth/reset-password",
            "destination": "/api/auth"
        },
        {
            "source": "/api/products/:id",
            "destination": "/api/products"
        },
        {
            "source": "/api/orders/myorders",
            "destination": "/api/orders"
        },
        {
            "source": "/api/orders/:id/submit-utr",
            "destination": "/api/orders"
        },
        {
            "source": "/api/orders/:id/verify-payment",
            "destination": "/api/orders"
        },
        {
            "source": "/api/orders/:id/status",
            "destination": "/api/orders"
        },
        {
            "source": "/api/orders/:id/send-giftcard",
            "destination": "/api/orders"
        },
        {
            "source": "/api/orders/:id",
            "destination": "/api/orders"
        },
        {
            "source": "/api/payment/config",
            "destination": "/api/payment"
        },
        {
            "source": "/api/cart",
            "destination": "/api/cart"
        },
        {
            "source": "/api/cart/add",
            "destination": "/api/cart"
        },
        {
            "source": "/api/cart/remove/:productId",
            "destination": "/api/cart"
        },
        {
            "source": "/api/cart/update/:productId",
            "destination": "/api/cart"
        },
        {
            "source": "/api/cart/check/:productId",
            "destination": "/api/cart"
        },
        {
            "source": "/api/wishlist/add",
            "destination": "/api/wishlist"
        },
        {
            "source": "/api/wishlist/remove/:productId",
            "destination": "/api/wishlist"
        },
        {
            "source": "/api/users/:id",
            "destination": "/api/users"
        },
        {
            "source": "/api/email",
            "destination": "/api/email"
        },
        {
            "source": "/api/trigger-expiry-check",
            "destination": "/api/trigger-expiry-check"
        },
        {
            "source": "/api/trigger-expiry-stock-update",
            "destination": "/api/trigger-expiry-stock-update"
        }
    ],
    "crons": [
        {
            "path": "/api/products?triggerExpiryCheck=true",
            "schedule": "0 10 * * *"
        }
    ]
}